model SalesOrder {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String           @map("business_id") @db.Uuid
  customerId    String?          @map("customer_id") @db.Uuid
  warehouseId   String?          @map("warehouse_id") @db.Uuid
  orderNumber   String           @map("order_number")
  orderDate     DateTime         @map("order_date") @db.Date
  currency      String           @default("USD")
  exchangeRate  Decimal          @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  subtotal      Decimal          @db.Decimal(20, 4)
  discountTotal Decimal          @default(0) @map("discount_total") @db.Decimal(20, 4)
  taxTotal      Decimal          @default(0) @map("tax_total") @db.Decimal(20, 4)
  grandTotal    Decimal          @map("grand_total") @db.Decimal(20, 4)
  status        SalesOrderStatus @default(draft)
  notes         String?
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business          Business           @relation(fields: [businessId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  creator           User?              @relation("SalesOrderCreatedBy", fields: [createdBy], references: [id])
  items             SalesOrderItem[]
  invoices          Sale[]
  stockReservations StockReservation[]
  opportunities     SalesOpportunity[]
  creditOverrides   CreditOverride[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId String      @map("sales_order_id") @db.Uuid
  productId    String?     @map("product_id") @db.Uuid
  warehouseId  String?     @map("warehouse_id") @db.Uuid
  description  String
  quantity     Decimal     @db.Decimal(15, 4)
  unitPrice    Decimal     @map("unit_price") @db.Decimal(20, 4)
  discount     Decimal     @default(0) @db.Decimal(8, 4)
  taxRate      Decimal     @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount    Decimal     @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal    Decimal     @map("line_total") @db.Decimal(20, 4)
  lineOrder    Int         @default(0) @map("line_order")

  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  stockReservations StockReservation[]

  @@map("sales_order_items")
}

model Sale {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  salesOrderId    String?      @map("sales_order_id") @db.Uuid
  invoiceNumber   String       @map("invoice_number")
  invoiceDate     DateTime     @map("invoice_date") @db.Date
  dueDate         DateTime?    @map("due_date") @db.Date
  status          SaleStatus   @default(draft)

  // Currency
  currencyCode    String       @default("USD") @map("currency_code")
  exchangeRate    Decimal      @default(1) @map("exchange_rate") @db.Decimal(20, 10)

  // Amounts (transaction currency)
  subtotal        Decimal      @db.Decimal(20, 4)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxAmount       Decimal      @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(20, 4)
  paidAmount      Decimal      @default(0) @map("paid_amount") @db.Decimal(20, 4) // Derived from allocations
  balanceDue      Decimal      @map("balance_due") @db.Decimal(20, 4)

  // Base currency amounts (for accounting & reporting)
  baseSubtotal    Decimal      @map("base_subtotal") @db.Decimal(20, 4)
  baseTaxAmount   Decimal      @default(0) @map("base_tax_amount") @db.Decimal(20, 4)
  baseTotalAmount Decimal      @map("base_total_amount") @db.Decimal(20, 4)

  notes           String?
  terms           String?
  postedAt        DateTime?    @map("posted_at") @db.Timestamptz()
  postedBy        String?      @map("posted_by") @db.Uuid
  voidedAt        DateTime?    @map("voided_at") @db.Timestamptz()
  voidReason      String?      @map("void_reason")

  createdBy       String       @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business           Business            @relation(fields: [businessId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  salesOrder         SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  creator            User                @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  items              SaleItem[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  paymentPromises    PaymentPromise[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([businessId, invoiceDate])
  @@map("sales")
}

model SaleItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId      String     @map("sale_id") @db.Uuid
  productId   String?    @map("product_id") @db.Uuid
  warehouseId String?    @map("warehouse_id") @db.Uuid
  description String
  quantity    Decimal    @db.Decimal(15, 4)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(20, 4)
  costBasis   Decimal    @default(0) @map("cost_basis") @db.Decimal(20, 4) // COGS calculation basis
  discount    Decimal    @default(0) @db.Decimal(8, 4) // Percentage
  taxRate     Decimal    @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal    @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal   Decimal    @map("line_total") @db.Decimal(20, 4)
  lineOrder   Int        @map("line_order")

  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

