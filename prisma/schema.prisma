model BankStatementLine {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String              @map("business_id") @db.Uuid
  statementId          String              @map("statement_id") @db.Uuid
  transactionDate      DateTime            @map("transaction_date") @db.Date
  valueDate            DateTime?           @map("value_date") @db.Date
  description          String
  reference            String?
  debitAmount          Decimal             @default(0) @map("debit_amount") @db.Decimal(20, 4)
  creditAmount         Decimal             @default(0) @map("credit_amount") @db.Decimal(20, 4)
  amount               Decimal             @db.Decimal(20, 4)
  currencyCode         String              @default("USD") @map("currency_code")
  externalId           String?             @map("external_id")
  isMatched            Boolean             @default(false) @map("is_matched")
  matchedTransactionId String?             @map("matched_transaction_id") @db.Uuid
  matchedAt            DateTime?           @map("matched_at") @db.Timestamptz()
  lineNumber           Int                 @default(0) @map("line_number")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business             Business            @relation(fields: [businessId], references: [id])
  statement            BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matches              ReconciliationMatch[]

  @@index([businessId, statementId])
  @@index([businessId, transactionDate])
  @@map("bank_statement_lines")
}

model BankReconciliation {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String                    @map("business_id") @db.Uuid
  reconciliationNumber   String                    @map("reconciliation_number")
  bankAccountId          String                    @map("bank_account_id") @db.Uuid
  statementId            String?                   @map("statement_id") @db.Uuid
  periodStart            DateTime                  @map("period_start") @db.Date
  periodEnd              DateTime                  @map("period_end") @db.Date
  statementEndingBalance Decimal                   @map("statement_ending_balance") @db.Decimal(20, 4)
  bookEndingBalance      Decimal                   @map("book_ending_balance") @db.Decimal(20, 4)
  clearedBalance         Decimal                   @default(0) @map("cleared_balance") @db.Decimal(20, 4)
  difference             Decimal                   @default(0) @map("difference") @db.Decimal(20, 4)
  status                 String                    @default("draft") // 'draft' | 'in_progress' | 'reconciled' | 'closed'
  notes                  String?
  closedBy               String?                   @map("closed_by") @db.Uuid
  closedAt               DateTime?                 @map("closed_at") @db.Timestamptz()
  reopenedBy             String?                   @map("reopened_by") @db.Uuid
  reopenedAt             DateTime?                 @map("reopened_at") @db.Timestamptz()
  reopenReason           String?                   @map("reopen_reason")
  createdBy              String                    @map("created_by") @db.Uuid
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business               Business                  @relation(fields: [businessId], references: [id])
  bankAccount            BankAccount               @relation(fields: [bankAccountId], references: [id])
  statement              BankStatement?            @relation(fields: [statementId], references: [id])
  closer                 User?                     @relation("ReconciliationClosedBy", fields: [closedBy], references: [id])
  reopener               User?                     @relation("ReconciliationReopenedBy", fields: [reopenedBy], references: [id])
  creator                User                      @relation("ReconciliationCreatedBy", fields: [createdBy], references: [id])
  matches                ReconciliationMatch[]
  adjustments            ReconciliationAdjustment[]

  @@unique([businessId, reconciliationNumber])
  @@index([businessId, bankAccountId, status])
  @@map("bank_reconciliations")
}

model ReconciliationMatch {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  reconciliationId    String             @map("reconciliation_id") @db.Uuid
  statementLineId     String             @map("statement_line_id") @db.Uuid
  bankTransactionId   String?            @map("bank_transaction_id") @db.Uuid
  journalEntryLineId  String?            @map("journal_entry_line_id") @db.Uuid
  matchedAmount       Decimal            @map("matched_amount") @db.Decimal(20, 4)
  matchType           String             @default("manual") @map("match_type") // 'auto' | 'manual'
  matchRule           String?            @map("match_rule")
  confidence          Decimal            @default(100) @db.Decimal(5, 2)
  matchedBy           String?            @map("matched_by") @db.Uuid
  matchedAt           DateTime           @default(now()) @map("matched_at") @db.Timestamptz()

  business            Business           @relation(fields: [businessId], references: [id])
  reconciliation      BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementLine       BankStatementLine  @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  bankTransaction     BankTransaction?   @relation(fields: [bankTransactionId], references: [id])
  matcher             User?              @relation("MatchCreatedBy", fields: [matchedBy], references: [id])

  @@index([businessId, reconciliationId])
  @@index([statementLineId])
  @@map("reconciliation_matches")
}

