// =============================================================
// Prisma Schema — Multi-Tenant SaaS Accounting & Business Platform
// Phase 02: Production-Grade Database Schema & Accounting Data Model
// Database: PostgreSQL (Supabase)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum UserStatus {
  active
  inactive
  suspended
}

enum BusinessStatus {
  active
  suspended
  closed
}

enum MemberRole {
  owner
  administrator
  accountant
  sales_user
  purchase_user
  inventory_user
  viewer
  custom
}

enum MemberStatus {
  active
  invited
  inactive
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum AccountNormalBalance {
  debit
  credit
}

enum JournalEntryStatus {
  draft
  posted
  reversed
  voided
}

enum JournalEntrySource {
  sale
  purchase
  payment
  expense
  manual
  opening_balance
  inventory_adjustment
  closing_entry
  treasury_transfer
  petty_cash
  bank_reconciliation
  treasury_transaction
}

enum SaleStatus {
  draft
  sent
  partial
  paid
  overdue
  voided
  cancelled
}

enum PurchaseStatus {
  draft
  received
  partial
  paid
  overdue
  voided
  cancelled
}

enum SalesOrderStatus {
  draft
  confirmed
  processing
  fulfilled
  cancelled
}

enum PurchaseOrderStatus {
  draft
  confirmed
  processing
  received
  cancelled
}

enum PaymentType {
  incoming       // From customer (AR)
  outgoing       // To supplier (AP)
  transfer       // Between accounts
  advance        // Customer / supplier advance
  refund         // Refund to customer / from supplier
}

enum PaymentDirection {
  inbound        // Money received
  outbound       // Money paid out
}

enum PaymentStatus {
  draft
  posted
  partially_allocated
  fully_allocated
  void
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  card
  other
}

enum TransactionType {
  deposit
  withdrawal
  transfer
}

enum InventoryMovementType {
  purchase
  sale
  purchase_return
  sales_return
  adjustment_increase
  adjustment_decrease
  transfer_in
  transfer_out
  opening_balance
}

enum TaxType {
  percentage
  fixed
}

enum AttachmentEntity {
  sale
  purchase
  expense
  payment
  supplier
  customer
  product
  journal_entry
  bank_account
}

enum AuditAction {
  create
  update
  delete
  void
  reverse
  post
  cancel
  login
  logout
  permission_change
}

// =============================================================
// A. CORE: USERS, BUSINESSES, ROLES & PERMISSIONS
// =============================================================

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String       @unique
  fullName          String       @map("full_name")
  avatarUrl         String?      @map("avatar_url")
  phone             String?
  preferredLanguage String       @default("en") @map("preferred_language")
  timezone          String       @default("UTC")
  status            UserStatus   @default(active)
  isSuperAdmin      Boolean      @default(false) @map("is_super_admin")
  superAdminNote    String?      @map("super_admin_note")  // Reason/label for this super admin account
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  businessMemberships   BusinessUser[]
  createdSales          Sale[]               @relation("SaleCreatedBy")
  createdPurchases      Purchase[]           @relation("PurchaseCreatedBy")
  createdSalesOrders    SalesOrder[]         @relation("SalesOrderCreatedBy")
  createdPurchaseOrders PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  createdJournalEntries JournalEntry[]       @relation("JournalCreatedBy")
  voidedJournalEntries  JournalEntry[]       @relation("JournalVoidedBy")
  postedJournalEntries  JournalEntry[]       @relation("JournalPostedBy")
  createdCustomers      Customer[]           @relation("CustomerCreatedBy")
  updatedCustomers      Customer[]           @relation("CustomerUpdatedBy")
  createdSuppliers      Supplier[]           @relation("SupplierCreatedBy")
  updatedSuppliers      Supplier[]           @relation("SupplierUpdatedBy")
  createdMovements      InventoryMovement[]  @relation("MovementCreatedBy")
  createdReservations   StockReservation[]   @relation("ReservationCreatedBy")
  createdPayments       Payment[]            @relation("PaymentCreatedBy")
  createdAllocations    PaymentAllocation[]  @relation("AllocationCreatedBy")
  createdExpenses       Expense[]            @relation("ExpenseCreatedBy")
  assignedCustomers     Customer[]           @relation("CustomerAssignedUser")
  assignedSuppliers     Supplier[]           @relation("SupplierAssignedUser")
  assignedOpportunities SalesOpportunity[]   @relation("OpportunityAssignedUser")
  assignedTasks         CrmTask[]            @relation("TaskAssignedUser")
  createdCrmTasks       CrmTask[]            @relation("TaskCreatedBy")
  createdActivities     CrmActivity[]        @relation("ActivityCreatedBy")
  assignedPromises      PaymentPromise[]     @relation("PromiseAssignedUser")
  authorizedOverrides   CreditOverride[]     @relation("CreditOverrideAuthorizedBy")
  custodianCashAccounts CashAccount[]        @relation("PettyCashCustodian")
  createdTreasuryTransfers TreasuryTransfer[] @relation("TreasuryTransferCreatedBy")
  approvedTreasuryTransfers TreasuryTransfer[] @relation("TreasuryTransferApprovedBy")
  postedTreasuryTransfers   TreasuryTransfer[] @relation("TreasuryTransferPostedBy")
  importedBankStatements   BankStatement[]   @relation("StatementImportedBy")
  closedReconciliations    BankReconciliation[] @relation("ReconciliationClosedBy")
  reopenedReconciliations  BankReconciliation[] @relation("ReconciliationReopenedBy")
  createdReconciliations   BankReconciliation[] @relation("ReconciliationCreatedBy")
  createdReconciliationMatches ReconciliationMatch[] @relation("MatchCreatedBy")
  createdReconciliationAdjustments ReconciliationAdjustment[] @relation("AdjustmentCreatedBy")
  custodianPettyCashCounts PettyCashCount[]  @relation("PettyCashCountCustodian")
  reviewedPettyCashCounts  PettyCashCount[]  @relation("PettyCashCountReviewedBy")
  postedPettyCashCounts    PettyCashCount[]  @relation("PettyCashCountPostedBy")
  createdPettyCashCounts   PettyCashCount[]  @relation("PettyCashCountCreatedBy")
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@map("users")
}

model Business {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String         // Display name
  legalName          String?        @map("legal_name")
  businessType       String?        @map("business_type")
  registrationNumber String?        @map("registration_number")
  taxNumber          String?        @map("tax_number")
  taxConfig          Json?          @map("tax_config")
  defaultCurrency    String         @default("USD") @map("default_currency")
  fiscalYearStart    String         @default("01-01") @map("fiscal_year_start") // MM-DD
  country            String?
  timezone           String         @default("UTC")
  logoUrl            String?        @map("logo_url")
  address            String?
  phone              String?
  email              String?
  website            String?
  status             BusinessStatus @default(active)
  onboardingCompleted Boolean       @default(false) @map("onboarding_completed")
  onboardingStep     Int            @default(1) @map("onboarding_step")
  onboardingData     Json?          @map("onboarding_data")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  creditControlConfig Json?                  @map("credit_control_config")

  // Relations
  members            BusinessUser[]
  roles              Role[]
  customers          Customer[]
  suppliers          Supplier[]
  categories         Category[]
  products           Product[]
  warehouses         Warehouse[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  salesOrders        SalesOrder[]
  sales              Sale[]
  purchaseOrders     PurchaseOrder[]
  purchases          Purchase[]
  expenses           Expense[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  cashAccounts       CashAccount[]
  bankAccounts       BankAccount[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
  journalEntryLines  JournalEntryLine[]
  taxes              Tax[]
  exchangeRates      ExchangeRate[]
  attachments        Attachment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  subscriptions      Subscription[]
  quotations         Quotation[]
  deliveryNotes      DeliveryNote[]
  purchaseRequests   PurchaseRequest[]
  goodsReceipts      GoodsReceipt[]
  salesReturns       SalesReturn[]
  purchaseReturns    PurchaseReturn[]
  creditDebitNotes   CreditDebitNote[]
  warehouseLocations WarehouseLocation[]
  inventoryLocationBalances InventoryLocationBalance[]
  stockReservations  StockReservation[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  stockCounts        StockCount[]
  productBatches     ProductBatch[]
  productSerialNumbers ProductSerialNumber[]
  customerGroups     CustomerGroup[]
  customerContacts   CustomerContact[]
  supplierContacts   SupplierContact[]
  crmActivities      CrmActivity[]
  crmTasks           CrmTask[]
  salesOpportunities SalesOpportunity[]
  paymentPromises    PaymentPromise[]
  creditOverrides    CreditOverride[]
  treasuryTransfers  TreasuryTransfer[]
  bankStatements     BankStatement[]
  bankStatementLines BankStatementLine[]
  bankReconciliations BankReconciliation[]
  reconciliationMatches ReconciliationMatch[]
  reconciliationAdjustments ReconciliationAdjustment[]
  pettyCashCounts    PettyCashCount[]
  accountingPeriods  AccountingPeriod[]

  @@map("businesses")
}

model Role {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String?        @map("business_id") @db.Uuid // null = global system role
  name        String
  code        String
  description String?
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  members         BusinessUser[]

  @@unique([businessId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique // e.g. "customers.view", "sales.create"
  module      String           // "customers", "sales", "accounting"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model BusinessUser {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  role        MemberRole    @default(viewer)
  roleId      String?       @map("role_id") @db.Uuid
  permissions Json?         // Custom overrides
  status      MemberStatus  @default(invited)
  invitedBy   String?       @map("invited_by") @db.Uuid
  invitedAt   DateTime?     @map("invited_at") @db.Timestamptz()
  joinedAt    DateTime?     @map("joined_at") @db.Timestamptz()
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleModel   Role?         @relation(fields: [roleId], references: [id])

  @@unique([userId, businessId])
  @@map("business_users")
}

// =============================================================
// B. PARTIES: CUSTOMERS & SUPPLIERS
// =============================================================

model Customer {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String    @map("business_id") @db.Uuid
  code                  String?   // Unique per business
  name                  String
  companyName           String?   @map("company_name")
  email                 String?
  phone                 String?
  mobile                String?
  whatsapp              String?
  website               String?
  address               String?
  billingAddress        String?   @map("billing_address")
  shippingAddress       String?   @map("shipping_address")
  city                  String?
  state                 String?
  postalCode            String?   @map("postal_code")
  country               String?
  taxNumber             String?   @map("tax_number")
  taxRegistrationNumber String?   @map("tax_registration_number")
  taxExemptionNumber    String?   @map("tax_exemption_number")
  creditLimit           Decimal?  @map("credit_limit") @db.Decimal(20, 4)
  creditStatus          String    @default("normal") @map("credit_status") // 'normal', 'warning', 'blocked'
  creditBlockReason     String?   @map("credit_block_reason")
  creditCategory        String?   @map("credit_category")
  balance               Decimal   @default(0) @map("balance") @db.Decimal(20, 4) // Cached, ledger is source of truth
  currency              String    @default("USD")
  paymentTerms          Int?      @default(30) @map("payment_terms") // Net days
  category              String?   // 'retail', 'wholesale', 'distributor', 'corporate', etc.
  industry              String?
  region                String?
  tags                  String[]  @default([])
  priceListId           String?   @map("price_list_id") @db.Uuid
  assignedUserId        String?   @map("assigned_user_id") @db.Uuid
  customerGroupId       String?   @map("customer_group_id") @db.Uuid
  notes                 String?
  isActive              Boolean   @default(true) @map("is_active")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  business         Business           @relation(fields: [businessId], references: [id])
  creator          User?              @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  updater          User?              @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id])
  assignedUser     User?              @relation("CustomerAssignedUser", fields: [assignedUserId], references: [id])
  customerGroup    CustomerGroup?     @relation(fields: [customerGroupId], references: [id])
  salesOrders      SalesOrder[]
  sales            Sale[]
  payments         Payment[]
  journalLines     JournalEntryLine[]
  quotations       Quotation[]
  deliveryNotes    DeliveryNote[]
  salesReturns     SalesReturn[]
  creditDebitNotes CreditDebitNote[]
  contacts         CustomerContact[]
  activities       CrmActivity[]
  tasks            CrmTask[]
  opportunities    SalesOpportunity[]
  paymentPromises  PaymentPromise[]
  creditOverrides  CreditOverride[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@map("customers")
}

model Supplier {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String    @map("business_id") @db.Uuid
  code                  String?
  name                  String
  companyName           String?   @map("company_name")
  email                 String?
  phone                 String?
  mobile                String?
  whatsapp              String?
  website               String?
  address               String?
  billingAddress        String?   @map("billing_address")
  shippingAddress       String?   @map("shipping_address")
  city                  String?
  state                 String?
  postalCode            String?   @map("postal_code")
  country               String?
  taxNumber             String?   @map("tax_number")
  taxRegistrationNumber String?   @map("tax_registration_number")
  balance               Decimal   @default(0) @map("balance") @db.Decimal(20, 4) // Cached, ledger is source of truth
  currency              String    @default("USD")
  paymentTerms          Int?      @default(30) @map("payment_terms")
  category              String?
  industry              String?
  region                String?
  tags                  String[]  @default([])
  assignedUserId        String?   @map("assigned_user_id") @db.Uuid
  rating                Decimal?  @db.Decimal(3, 2)
  notes                 String?
  isActive              Boolean   @default(true) @map("is_active")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  business         Business           @relation(fields: [businessId], references: [id])
  creator          User?              @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  updater          User?              @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id])
  assignedUser     User?              @relation("SupplierAssignedUser", fields: [assignedUserId], references: [id])
  purchaseOrders   PurchaseOrder[]
  purchases        Purchase[]
  expenses         Expense[]
  payments         Payment[]
  journalLines     JournalEntryLine[]
  goodsReceipts    GoodsReceipt[]
  purchaseReturns  PurchaseReturn[]
  creditDebitNotes CreditDebitNote[]
  preferredProducts Product[]
  contacts         SupplierContact[]
  activities       CrmActivity[]
  tasks            CrmTask[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("suppliers")
}

// =============================================================
// C. PRODUCTS, CATEGORIES & INVENTORY
// =============================================================

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  name        String
  description String?
  type        String     @default("product") // 'product' | 'expense'
  parentId    String?    @map("parent_id") @db.Uuid
  status      String     @default("active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz()

  business    Business   @relation(fields: [businessId], references: [id])
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")
  products    Product[]
  expenses    Expense[]

  @@map("categories")
}

model Warehouse {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String
  code        String?   // Unique per business
  location    String?
  address     String?
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  business            Business                   @relation(fields: [businessId], references: [id])
  locations           WarehouseLocation[]
  inventoryBalances   InventoryBalance[]
  locationBalances    InventoryLocationBalance[]
  inventoryMovements  InventoryMovement[]
  stockReservations   StockReservation[]
  stockTransfersFrom  StockTransfer[]            @relation("TransferFromWarehouse")
  stockTransfersTo    StockTransfer[]            @relation("TransferToWarehouse")
  stockAdjustments    StockAdjustment[]
  stockCounts         StockCount[]
  productBatches      ProductBatch[]
  productSerialNumbers ProductSerialNumber[]
  salesOrders         SalesOrder[]
  salesOrderItems     SalesOrderItem[]
  saleItems           SaleItem[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseItems       PurchaseItem[]
  deliveryNotes       DeliveryNote[]
  deliveryNoteItems   DeliveryNoteItem[]
  purchaseRequests    PurchaseRequest[]
  goodsReceipts       GoodsReceipt[]
  goodsReceiptItems   GoodsReceiptItem[]
  salesReturns        SalesReturn[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]

  @@unique([businessId, code])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String    // e.g. "A1-R2-S3-B4"
  name        String    // e.g. "Aisle 1, Rack 2, Shelf 3, Bin 4"
  aisle       String?
  rack        String?
  shelf       String?
  bin         String?
  zone        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  business            Business                   @relation(fields: [businessId], references: [id])
  warehouse           Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationBalances    InventoryLocationBalance[]
  inventoryMovements  InventoryMovement[]
  stockReservations   StockReservation[]
  batches             ProductBatch[]
  serialNumbers       ProductSerialNumber[]
  countItems          StockCountItem[]
  transferItemsFrom   StockTransferItem[]        @relation("TransferItemFromLocation")
  transferItemsTo     StockTransferItem[]        @relation("TransferItemToLocation")
  transfersFrom       StockTransfer[]            @relation("TransferFromLocation")
  transfersTo         StockTransfer[]            @relation("TransferToLocation")
  adjustmentItems     StockAdjustmentItem[]

  @@unique([businessId, warehouseId, code])
  @@index([businessId, warehouseId, isActive])
  @@map("warehouse_locations")
}

model Product {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  code               String?   // SKU
  barcode            String?
  name               String
  description        String?
  productType        String    @default("physical") @map("product_type") // 'physical' | 'service'
  unitOfMeasure      String    @default("unit") @map("unit_of_measure")
  salePrice          Decimal   @map("sale_price") @db.Decimal(20, 4)
  purchasePrice      Decimal?  @map("purchase_price") @db.Decimal(20, 4)
  costPrice          Decimal   @default(0) @map("cost_price") @db.Decimal(20, 4) // Weighted average cost
  currency           String    @default("USD")
  taxId              String?   @map("tax_id") @db.Uuid
  taxRate            Decimal   @default(0) @map("tax_rate") @db.Decimal(8, 4)
  trackInventory     Boolean   @default(true) @map("track_inventory")
  reorderLevel       Decimal?  @map("reorder_level") @db.Decimal(15, 4) // Minimum stock
  minStock           Decimal?  @map("min_stock") @db.Decimal(15, 4)
  maxStock           Decimal?  @map("max_stock") @db.Decimal(15, 4)
  reorderQuantity    Decimal?  @map("reorder_quantity") @db.Decimal(15, 4)
  safetyStock        Decimal?  @map("safety_stock") @db.Decimal(15, 4)
  leadTimeDays       Int?      @map("lead_time_days")
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  isBatchTracked     Boolean   @default(false) @map("is_batch_tracked")
  isSerialTracked    Boolean   @default(false) @map("is_serial_tracked")
  imageUrl           String?   @map("image_url")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  business             Business                   @relation(fields: [businessId], references: [id])
  category             Category?                  @relation(fields: [categoryId], references: [id])
  tax                  Tax?                       @relation(fields: [taxId], references: [id])
  preferredSupplier    Supplier?                  @relation(fields: [preferredSupplierId], references: [id])
  inventoryBalances    InventoryBalance[]
  locationBalances     InventoryLocationBalance[]
  inventoryMovements   InventoryMovement[]
  stockReservations    StockReservation[]
  batches              ProductBatch[]
  serialNumbers        ProductSerialNumber[]
  stockTransferItems   StockTransferItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockCountItems      StockCountItem[]
  salesOrderItems      SalesOrderItem[]
  saleItems            SaleItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseItems        PurchaseItem[]
  journalLines         JournalEntryLine[]
  quotationItems       QuotationItem[]
