model PurchaseOrder {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String              @map("business_id") @db.Uuid
  supplierId    String?             @map("supplier_id") @db.Uuid
  warehouseId   String?             @map("warehouse_id") @db.Uuid
  orderNumber   String              @map("order_number")
  orderDate     DateTime            @map("order_date") @db.Date
  currency      String              @default("USD")
  exchangeRate  Decimal             @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  subtotal      Decimal             @db.Decimal(20, 4)
  discountTotal Decimal             @default(0) @map("discount_total") @db.Decimal(20, 4)
  taxTotal      Decimal             @default(0) @map("tax_total") @db.Decimal(20, 4)
  grandTotal    Decimal             @map("grand_total") @db.Decimal(20, 4)
  status        PurchaseOrderStatus @default(draft)
  notes         String?
  createdBy     String?             @map("created_by") @db.Uuid
  updatedBy     String?             @map("updated_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business      Business            @relation(fields: [businessId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  creator       User?               @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  items         PurchaseOrderItem[]
  purchases     Purchase[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  warehouseId     String?       @map("warehouse_id") @db.Uuid
  description     String
  quantity        Decimal       @db.Decimal(15, 4)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(20, 4)
  taxRate         Decimal       @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal       Decimal       @map("line_total") @db.Decimal(20, 4)
  lineOrder       Int           @default(0) @map("line_order")

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id])
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@map("purchase_order_items")
}

model Purchase {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  supplierId      String?        @map("supplier_id") @db.Uuid
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  referenceNumber String?        @map("reference_number") // Supplier's invoice number
  purchaseNumber  String         @map("purchase_number")
  purchaseDate    DateTime       @map("purchase_date") @db.Date
  dueDate         DateTime?      @map("due_date") @db.Date
  status          PurchaseStatus @default(draft)

  currencyCode    String         @default("USD") @map("currency_code")
  exchangeRate    Decimal        @default(1) @map("exchange_rate") @db.Decimal(20, 10)

  subtotal        Decimal        @db.Decimal(20, 4)
  discountAmount  Decimal        @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxAmount       Decimal        @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(20, 4)
  paidAmount      Decimal        @default(0) @map("paid_amount") @db.Decimal(20, 4)
  balanceDue      Decimal        @map("balance_due") @db.Decimal(20, 4)

  baseSubtotal    Decimal        @map("base_subtotal") @db.Decimal(20, 4)
  baseTaxAmount   Decimal        @default(0) @map("base_tax_amount") @db.Decimal(20, 4)
  baseTotalAmount Decimal        @map("base_total_amount") @db.Decimal(20, 4)

  notes           String?
  postedAt        DateTime?      @map("posted_at") @db.Timestamptz()
  postedBy        String?        @map("posted_by") @db.Uuid
  voidedAt        DateTime?      @map("voided_at") @db.Timestamptz()
  voidReason      String?        @map("void_reason")

  createdBy       String         @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business           Business            @relation(fields: [businessId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  creator            User                @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])
  items              PurchaseItem[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]

  @@unique([businessId, purchaseNumber])
  @@index([businessId, status])
  @@index([businessId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId  String     @map("purchase_id") @db.Uuid
  productId   String?    @map("product_id") @db.Uuid
  warehouseId String?    @map("warehouse_id") @db.Uuid
  description String
  quantity    Decimal    @db.Decimal(15, 4)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(20, 4)
  taxRate     Decimal    @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal    @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal   Decimal    @map("line_total") @db.Decimal(20, 4)
  lineOrder   Int        @map("line_order")

  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

// =============================================================
// F. PAYMENTS & FIRST-CLASS PAYMENT ALLOCATIONS
// =============================================================

model Payment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String           @map("business_id") @db.Uuid
  paymentNumber     String           @map("payment_number")
  paymentDate       DateTime         @map("payment_date") @db.Date
  type              PaymentType
  direction         PaymentDirection @default(inbound)
  status            PaymentStatus    @default(posted)
  method            PaymentMethod    @default(cash)

  // Direct relations (optional / backwards compatibility)
  saleId            String?          @map("sale_id") @db.Uuid
  purchaseId        String?          @map("purchase_id") @db.Uuid
  customerId        String?          @map("customer_id") @db.Uuid
  supplierId        String?          @map("supplier_id") @db.Uuid

  // Account it came from / goes to
  cashAccountId     String?          @map("cash_account_id") @db.Uuid
  bankAccountId     String?          @map("bank_account_id") @db.Uuid

  currencyCode      String           @default("USD") @map("currency_code")
  exchangeRate      Decimal          @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  amount            Decimal          @db.Decimal(20, 4)
  baseAmount        Decimal          @map("base_amount") @db.Decimal(20, 4)
  allocatedAmount   Decimal          @default(0) @map("allocated_amount") @db.Decimal(20, 4)
  unallocatedAmount Decimal          @default(0) @map("unallocated_amount") @db.Decimal(20, 4)

  reference         String?
  notes             String?
  isVoided          Boolean          @default(false) @map("is_voided")
  voidedAt          DateTime?        @map("voided_at") @db.Timestamptz()
  voidReason        String?          @map("void_reason")

  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business          Business            @relation(fields: [businessId], references: [id])
  sale              Sale?               @relation(fields: [saleId], references: [id])
  purchase          Purchase?           @relation(fields: [purchaseId], references: [id])
  customer          Customer?           @relation(fields: [customerId], references: [id])
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  cashAccount       CashAccount?        @relation(fields: [cashAccountId], references: [id])
  bankAccount       BankAccount?        @relation(fields: [bankAccountId], references: [id])
  creator           User?               @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  allocations       PaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@index([businessId, paymentDate])
  @@index([businessId, type])
  @@map("payments")
}

model PaymentAllocation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  saleId             String?   @map("sale_id") @db.Uuid        // Sales Invoice link
  purchaseId         String?   @map("purchase_id") @db.Uuid    // Purchase Invoice link
  allocatedAmount    Decimal   @map("allocated_amount") @db.Decimal(20, 4)
  allocatedBaseAmount Decimal  @map("allocated_base_amount") @db.Decimal(20, 4)
  allocationDate     DateTime  @default(now()) @map("allocation_date") @db.Timestamptz()
  notes              String?
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  business           Business  @relation(fields: [businessId], references: [id])
  payment            Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale               Sale?     @relation(fields: [saleId], references: [id])
  purchase           Purchase? @relation(fields: [purchaseId], references: [id])
  creator            User?     @relation("AllocationCreatedBy", fields: [createdBy], references: [id])

  @@index([businessId, paymentId])
  @@index([saleId])
  @@index([purchaseId])
  @@map("payment_allocations")
}

// =============================================================
// G. EXPENSES
// =============================================================

model Expense {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String         @map("business_id") @db.Uuid
  categoryId     String?        @map("category_id") @db.Uuid
  accountId      String?        @map("account_id") @db.Uuid // Chart of Accounts link
  supplierId     String?        @map("supplier_id") @db.Uuid
  expenseNumber  String         @map("expense_number")
  expenseDate    DateTime       @map("expense_date") @db.Date
  description    String
  vendor         String?
  currencyCode   String         @default("USD") @map("currency_code")
  exchangeRate   Decimal        @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  amount         Decimal        @db.Decimal(20, 4)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(20, 4)
  baseAmount     Decimal        @map("base_amount") @db.Decimal(20, 4)
  cashAccountId  String?        @map("cash_account_id") @db.Uuid
  bankAccountId  String?        @map("bank_account_id") @db.Uuid
  paymentStatus  String         @default("paid") @map("payment_status") // 'paid' | 'unpaid'
  status         String         @default("posted") // 'draft' | 'posted' | 'void'
  isVoided       Boolean        @default(false) @map("is_voided")
  notes          String?
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business       Business        @relation(fields: [businessId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  account        ChartOfAccount? @relation(fields: [accountId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  cashAccount    CashAccount?    @relation(fields: [cashAccountId], references: [id])
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  creator        User?           @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])

  @@unique([businessId, expenseNumber])
  @@index([businessId, expenseDate])
  @@map("expenses")
}

// =============================================================
// H. CASH & BANK ACCOUNTS
// =============================================================

model CashAccount {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  name           String
  code           String?
  currencyCode   String          @default("USD") @map("currency_code")
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(20, 4)
  balance        Decimal         @default(0) @db.Decimal(20, 4)
  accountId      String?         @map("account_id") @db.Uuid // Linked Chart of Account
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  isPettyCash    Boolean         @default(false) @map("is_petty_cash")
  custodianId    String?         @map("custodian_id") @db.Uuid
  targetFloat    Decimal?        @map("target_float") @db.Decimal(20, 4)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business       Business        @relation(fields: [businessId], references: [id])
  account        ChartOfAccount? @relation(fields: [accountId], references: [id])
  custodian      User?           @relation("PettyCashCustodian", fields: [custodianId], references: [id])
  transactions   CashTransaction[]
  payments       Payment[]
  expenses       Expense[]
  pettyCashCounts PettyCashCount[]

  @@map("cash_accounts")
}

model CashTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashAccountId   String          @map("cash_account_id") @db.Uuid
  businessId      String?         @map("business_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(20, 4)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(20, 4)
  description     String
  reference       String?
  sourceType      String?         @map("source_type")
  sourceId        String?         @map("source_id") @db.Uuid
  journalEntryId  String?         @map("journal_entry_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  cashAccount     CashAccount     @relation(fields: [cashAccountId], references: [id])

  @@index([cashAccountId, transactionDate])
  @@map("cash_transactions")
}

model BankAccount {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String            @map("business_id") @db.Uuid
  bankName       String            @map("bank_name")
  accountName    String            @map("account_name")
  code           String?
  accountNumber  String?           @map("account_number")
  iban           String?
  swift          String?
  branch         String?
  currencyCode   String            @default("USD") @map("currency_code")
  openingBalance Decimal           @default(0) @map("opening_balance") @db.Decimal(20, 4)
  balance        Decimal           @default(0) @db.Decimal(20, 4)
  accountId      String?           @map("account_id") @db.Uuid // Linked Chart of Account
  isDefault      Boolean           @default(false) @map("is_default")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business       Business          @relation(fields: [businessId], references: [id])
  account        ChartOfAccount?   @relation(fields: [accountId], references: [id])
  transactions   BankTransaction[]
  payments       Payment[]
  expenses       Expense[]
  statements     BankStatement[]
  reconciliations BankReconciliation[]
  adjustments    ReconciliationAdjustment[]

  @@map("bank_accounts")
}

model BankTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId   String          @map("bank_account_id") @db.Uuid
  businessId      String?         @map("business_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(20, 4)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(20, 4)
  description     String
  reference       String?
  isReconciled    Boolean         @default(false) @map("is_reconciled")
  reconciledAt    DateTime?       @map("reconciled_at") @db.Timestamptz()
  sourceType      String?         @map("source_type")
  sourceId        String?         @map("source_id") @db.Uuid
  journalEntryId  String?         @map("journal_entry_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id])
  reconciliationMatches ReconciliationMatch[]

  @@index([bankAccountId, transactionDate])
  @@map("bank_transactions")
}

// =============================================================
// I. DOUBLE-ENTRY ACCOUNTING: CHART OF ACCOUNTS & JOURNALS
// =============================================================

model ChartOfAccount {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  parentId       String?              @map("parent_id") @db.Uuid
  code           String
  name           String
  type           AccountType
  normalBalance  AccountNormalBalance @map("normal_balance")
  currency       String?
  description    String?
  isHeader       Boolean              @default(false) @map("is_header")
  isSystem       Boolean              @default(false) @map("is_system")
  balance        Decimal              @default(0) @db.Decimal(20, 4) // Cached, ledger is source of truth
  isActive       Boolean              @default(true) @map("is_active")
  sortOrder      Int                  @default(0) @map("sort_order")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business       Business             @relation(fields: [businessId], references: [id])
  parent         ChartOfAccount?      @relation("AccountParent", fields: [parentId], references: [id])
  children       ChartOfAccount[]     @relation("AccountParent")
  journalLines   JournalEntryLine[]
  cashAccounts   CashAccount[]
  bankAccounts   BankAccount[]
  expenses       Expense[]
  salesTaxes     Tax[]                @relation("TaxSalesAccount")
  purchaseTaxes  Tax[]                @relation("TaxPurchaseAccount")
  reconciliationAdjustments ReconciliationAdjustment[]
  pettyCashVariances PettyCashCount[] @relation("PettyCashVarianceAccount")

  @@unique([businessId, code])
  @@index([businessId, type])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  entryNumber     String             @map("entry_number")
  entryDate       DateTime           @map("entry_date") @db.Date
  description     String?
  currencyCode    String             @default("USD") @map("currency_code")
  exchangeRate    Decimal            @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  reference       String?
  sourceType      JournalEntrySource? @map("source_type")
  sourceId        String?            @map("source_id") @db.Uuid
  status          JournalEntryStatus @default(draft)
  postedAt        DateTime?          @map("posted_at") @db.Timestamptz()
  postedBy        String?            @map("posted_by") @db.Uuid
  voidedAt        DateTime?          @map("voided_at") @db.Timestamptz()
  voidedBy        String?            @map("voided_by") @db.Uuid
  voidReason      String?            @map("void_reason")
  reversedEntryId String?            @map("reversed_entry_id") @db.Uuid

  createdBy       String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business        Business           @relation(fields: [businessId], references: [id])
  creator         User               @relation("JournalCreatedBy", fields: [createdBy], references: [id])
  voider          User?              @relation("JournalVoidedBy", fields: [voidedBy], references: [id])
  poster          User?              @relation("JournalPostedBy", fields: [postedBy], references: [id])
  reversedEntry   JournalEntry?      @relation("ReversalPair", fields: [reversedEntryId], references: [id])
  reversingEntries JournalEntry[]    @relation("ReversalPair")
  lines           JournalEntryLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, entryDate])
  @@index([businessId, status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String         @map("journal_entry_id") @db.Uuid
  businessId     String         @map("business_id") @db.Uuid
  accountId      String         @map("account_id") @db.Uuid
  description    String?
  debitAmount    Decimal        @default(0) @map("debit_amount") @db.Decimal(20, 4)
  creditAmount   Decimal        @default(0) @map("credit_amount") @db.Decimal(20, 4)
  currencyCode   String         @default("USD") @map("currency_code")
  exchangeRate   Decimal        @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  baseDebit      Decimal        @default(0) @map("base_debit") @db.Decimal(20, 4)
  baseCredit     Decimal        @default(0) @map("base_credit") @db.Decimal(20, 4)
  customerId     String?        @map("customer_id") @db.Uuid
  supplierId     String?        @map("supplier_id") @db.Uuid
  productId      String?        @map("product_id") @db.Uuid
  lineOrder      Int            @map("line_order")

  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  business       Business       @relation(fields: [businessId], references: [id])
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  product        Product?       @relation(fields: [productId], references: [id])

  @@index([journalEntryId])
  @@index([businessId, accountId])
  @@index([customerId])
  @@index([supplierId])
  @@map("journal_entry_lines")
}

// =============================================================
// J. TAXES & CURRENCIES
// =============================================================

model Tax {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  name              String          // "VAT 15%", "Standard Rate"
  code              String          // "VAT15"
  rate              Decimal         @db.Decimal(8, 4)
  taxType           TaxType         @default(percentage) @map("tax_type")
  salesAccountId    String?         @map("sales_account_id") @db.Uuid
  purchaseAccountId String?         @map("purchase_account_id") @db.Uuid
  isDefault         Boolean         @default(false) @map("is_default")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business          Business        @relation(fields: [businessId], references: [id])
  salesAccount      ChartOfAccount? @relation("TaxSalesAccount", fields: [salesAccountId], references: [id])
  purchaseAccount   ChartOfAccount? @relation("TaxPurchaseAccount", fields: [purchaseAccountId], references: [id])
  products          Product[]

  @@unique([businessId, code])
  @@map("taxes")
}

model Currency {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique // ISO 4217, e.g. "USD", "EUR", "TRY", "SAR", "AED"
  name          String
  symbol        String
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(20, 10)
  rateDate     DateTime @map("rate_date") @db.Date
  source       String   @default("manual") // 'manual', 'central_bank'
