  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("feature_flags")
}

// =============================================================
// P. PHASE 18: FISCAL PERIOD LOCKING
// Prevents backdated transactions in closed/locked accounting periods.
// A period can be 'open' (default), 'closed' (soft lock, accountants can override),
// or 'locked' (hard lock, only administrators can unlock).
// =============================================================

model AccountingPeriod {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid

  // Period definition: year + month (month=0 means the entire fiscal year)
  fiscalYear  Int      @map("fiscal_year")
  fiscalMonth Int      @map("fiscal_month") // 1–12 for monthly, 0 for annual

  // Period dates
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  // Status: 'open' | 'closed' | 'locked'
  // open   — transactions allowed
  // closed — soft lock: accountants & admins can still post with a reason
  // locked — hard lock: no new transactions, only administrators can unlock
  status      String   @default("open") // 'open', 'closed', 'locked'

  // Locking audit trail
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz()
  lockedBy    String?   @map("locked_by") @db.Uuid
  closedAt    DateTime? @map("closed_at") @db.Timestamptz()
  closedBy    String?   @map("closed_by") @db.Uuid
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  business    Business @relation(fields: [businessId], references: [id])

  // Only one period per year+month per business
  @@unique([businessId, fiscalYear, fiscalMonth])
  @@index([businessId, status])
  @@index([businessId, periodStart, periodEnd])
  @@map("accounting_periods")
}
