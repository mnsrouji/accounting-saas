  bankAccountId   String             @map("bank_account_id") @db.Uuid
  statementNumber String             @map("statement_number")
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  openingBalance  Decimal            @map("opening_balance") @db.Decimal(20, 4)
  closingBalance  Decimal            @map("closing_balance") @db.Decimal(20, 4)
  totalDebits     Decimal            @default(0) @map("total_debits") @db.Decimal(20, 4)
  totalCredits    Decimal            @default(0) @map("total_credits") @db.Decimal(20, 4)
  currencyCode    String             @default("USD") @map("currency_code")
  status          String             @default("imported") // 'imported' | 'reconciling' | 'reconciled' | 'closed'
  importedBy      String?            @map("imported_by") @db.Uuid
