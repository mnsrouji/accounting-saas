# ============================================================
# ACCOUNTING SAAS — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- SUPABASE (Required) -----------------------------------
# Get these from: https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVICE ROLE KEY — SERVER ONLY. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- DATABASE (Required for Prisma) ------------------------
# Get these from: Supabase > Project Settings > Database
# Use the "Transaction" pooler for serverless (port 6543)
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the "Session" pooler or direct connection for migrations
DIRECT_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---- APP (Required) ----------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AccountFlow

# ---- BILLING (Phase 15) ------------------------------------
# Set BILLING_PROVIDER to 'stripe' (production) or 'mock' (dev/test)
# Default: auto-detects Stripe if STRIPE_SECRET_KEY is set, otherwise mock
BILLING_PROVIDER=mock

# Stripe credentials (required only when BILLING_PROVIDER=stripe)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — map each plan/interval to a Stripe price
# Get these from: Stripe Dashboard > Products
STRIPE_PRICE_STARTER_MONTH=price_...
STRIPE_PRICE_STARTER_YEAR=price_...
STRIPE_PRICE_PROFESSIONAL_MONTH=price_...
STRIPE_PRICE_PROFESSIONAL_YEAR=price_...
STRIPE_PRICE_ENTERPRISE_MONTH=price_...
STRIPE_PRICE_ENTERPRISE_YEAR=price_...

# ---- EMAIL (Optional - for transactional email) ------------
# Resend: https://resend.com
RESEND_API_KEY=re_...

# ---- OBSERVABILITY (Optional) ------------------------------
# Sentry: https://sentry.io/settings/ > Projects > DSN
# When set, uncaught server errors are captured automatically
SENTRY_DSN=https://...@sentry.io/...

# ---- ENVIRONMENT -------------------------------------------
NODE_ENV=development
